# Greek Office settings. Copy to .env; docker compose reads it from this folder.

# Who may use the app. Comma-separated IPv4/IPv6 addresses or CIDR ranges; everyone else gets
# HTTP 403. Use `all` to let everyone in.
#
#   GREEK_ALLOWED_IPS=192.168.1.0/24,203.0.113.7,2001:db8::/32
#
# Apply a change with `docker compose up -d` (`docker compose restart` keeps the old value).
# An empty value or a bad entry stops the container; `docker logs greek-office` says why.
GREEK_ALLOWED_IPS=all
